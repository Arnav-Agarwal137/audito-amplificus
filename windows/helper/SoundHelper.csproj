<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows ears of the Sound app: what is playing (SMTC), which output (Core Audio), and the spectrum of the
       mix (WASAPI loopback). It never changes the sound - Equalizer APO does that. JSON lines on stdout. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>SoundHelper</AssemblyName>
    <AssemblyTitle>Audito Amplificus listener</AssemblyTitle>
    <Product>Audito Amplificus</Product>
    <Company>Arnav Agarwal</Company>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>
</Project>
