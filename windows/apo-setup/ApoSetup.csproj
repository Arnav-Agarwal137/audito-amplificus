<Project Sdk="Microsoft.NET.Sdk">
  <!-- Switches Equalizer APO on for EVERY playback output, the way its own Device Selector does when you tick a
       device (port of DeviceAPOInfo.cpp load()+install() from Equalizer APO 1.4.2, GPLv2). Run once with admin at
       install; a SYSTEM task re-runs it when a device is plugged in or connected, so new headphones just work.
       Bug it fixes (9 Oct 2026): the app did nothing on his dongle and Bluetooth headphones. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>ApoSetup</AssemblyName>
    <!-- what Windows' permission prompt and Task Manager show for this exe -->
    <AssemblyTitle>Audito Amplificus sound setup</AssemblyTitle>
    <Product>Audito Amplificus</Product>
    <Company>Arnav Agarwal</Company>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>
</Project>
